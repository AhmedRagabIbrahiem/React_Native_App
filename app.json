{
  "expo": {
    "name": "Cafe App",
    "slug": "cafe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cafe-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2C1810"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cafe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2C1810"
      },
      "package": "com.cafe.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
