# Expo app → API
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Supabase (backend only — copy to .env, never commit .env) ---
# Supabase Dashboard → Project Settings → Database → Connection string
#
# IGNORE the broken one-line URI Supabase sometimes shows. Build it like this:
#
# OPTION A — Session pooler (use this on Docker / IPv4 networks)
# Tab: "Connection pooling" → Mode: Session → copy Host, then:
# DATABASE_URL=postgresql://postgres.tkbfiusyccfsxfdjnmrg:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# OPTION B — Direct (IPv6 only; may fail from Docker on Windows)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.tkbfiusyccfsxfdjnmrg.supabase.co:5432/postgres
#
DATABASE_URL=
SUPABASE_TABLE=Clients_orders
